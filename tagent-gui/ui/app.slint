import { Button, ComboBox, ScrollView, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "Tagent";
    preferred-width: 560px;
    preferred-height: 420px;

    in-out property <string> input-text: "";
    in-out property <string> transcript: "=== Tagent ===\nType text and press Enter to translate.\n\n";
    in-out property <[string]> languages: ["Auto", "English", "Russian", "Spanish", "French", "German"];
    in-out property <int> source-language-index: 0;
    in-out property <int> target-language-index: 2;

    // Height the user picked by dragging the resize handle; clamped and
    // combined with the wrapped text's natural height below.
    in-out property <length> input-user-height: 32px;
    property <length> input-min-height: 32px;
    property <length> input-max-height: 220px;
    property <length> input-box-height: max(input-min-height, min(input-max-height,
        max(input-user-height, input-field.preferred-height + 16px)));

    out property <length> transcript-viewport-height <=> transcript-scroll.viewport-height;
    out property <length> transcript-visible-height <=> transcript-scroll.visible-height;
    in-out property <length> transcript-viewport-y <=> transcript-scroll.viewport-y;

    callback translate-requested(string, string, string);
    callback swap-requested();

    VerticalBox {
        HorizontalBox {
            ComboBox {
                model: languages;
                current-index <=> source-language-index;
            }

            Button {
                text: "⇄";
                clicked => { swap-requested(); }
            }

            ComboBox {
                model: languages;
                current-index <=> target-language-index;
            }
        }

        Rectangle {
            background: #0c0c0c;
            border-radius: 4px;
            border-width: 1px;
            border-color: #2a2a2a;
            vertical-stretch: 1;
            min-height: 60px;

            transcript-scroll := ScrollView {
                width: parent.width;
                height: parent.height;
                viewport-width: self.width;
                viewport-height: transcript-text.preferred-height + 16px;

                transcript-text := TextInput {
                    text: transcript;
                    font-family: "monospace";
                    font-size: 13px;
                    color: #d4d4d4;
                    selection-background-color: #264f78;
                    selection-foreground-color: #d4d4d4;
                    wrap: word-wrap;
                    single-line: false;
                    read-only: true;
                    horizontal-alignment: left;
                    vertical-alignment: top;
                    x: 8px;
                    y: 8px;
                    width: parent.width - 16px;
                    height: self.preferred-height;
                }
            }
        }

        resize-handle := Rectangle {
            height: 10px;

            Rectangle {
                width: 32px;
                height: 4px;
                border-radius: 2px;
                background: resize-touch.pressed ? #5a5a5a : resize-touch.has-hover ? #444444 : #2a2a2a;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            resize-touch := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: ns-resize;

                moved => {
                    if (self.pressed) {
                        input-user-height = max(input-min-height, min(input-max-height,
                            input-user-height - (self.mouse-y - self.pressed-y)));
                    }
                }
            }
        }

        Rectangle {
            background: #0c0c0c;
            border-radius: 4px;
            border-width: 1px;
            border-color: #2a2a2a;
            height: input-box-height;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 4px;
                alignment: stretch;

                Text {
                    text: "[" + languages[source-language-index] + "]:";
                    font-family: "monospace";
                    font-size: 13px;
                    color: #e5c07b;
                    vertical-alignment: center;
                }

                Rectangle {
                    background: #151515;
                    border-radius: 3px;
                    border-width: 1px;
                    border-color: #2a2a2a;
                    horizontal-stretch: 1;

                    ScrollView {
                        width: parent.width;
                        height: parent.height;
                        viewport-width: self.width;
                        viewport-height: input-field.preferred-height + 16px;

                        input-field := TextInput {
                            text <=> input-text;
                            font-size: 13px;
                            color: #d4d4d4;
                            selection-background-color: #264f78;
                            selection-foreground-color: #d4d4d4;
                            wrap: word-wrap;
                            single-line: false;
                            horizontal-alignment: left;
                            vertical-alignment: top;
                            x: 8px;
                            y: 8px;
                            width: parent.width - 16px;
                            height: self.preferred-height;

                            key-pressed(event) => {
                                if (event.text == Key.Return && !event.modifiers.shift) {
                                    translate-requested(
                                        input-text,
                                        languages[source-language-index],
                                        languages[target-language-index],
                                    );
                                    input-text = "";
                                    return accept;
                                }
                                return reject;
                            }
                        }
                    }
                }

                Button {
                    text: "Translate";
                    clicked => {
                        translate-requested(
                            input-text,
                            languages[source-language-index],
                            languages[target-language-index],
                        );
                        input-text = "";
                    }
                }
            }
        }
    }
}
