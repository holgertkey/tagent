import { Button, CheckBox, ComboBox, LineEdit, Palette, ScrollView, Slider, SpinBox, StandardButton, TabWidget, VerticalBox, HorizontalBox } from "std-widgets.slint";

// One translation round-trip in the transcript: the original phrase and its
// translation (or an error message), each rendered with its own independently
// configurable font/size/color/background — see AppWindow's phrase-*/translation-*
// style properties below. Each string already includes its "[Auto]:"-style
// prompt (or not, per show-prompt in config.rs) — baked in by main.rs when
// the entry is created, rather than rendered as a separately styled element,
// since Slint's plain Text/TextInput
// can't mix two styles within one wrapped paragraph; splitting the prompt out
// as its own element made it wrap flush under the text instead of the line
// wrapping flush from the left margin like a normal paragraph.
export struct TranscriptEntry {
    phrase: string,
    translation: string,
}

// Reusable "theme default, or pick a color" field used four times in
// SettingsDialog's View tab (phrase text/background, translation
// text/background). Combines a HEX text field (for typing an exact value)
// with a swatch button that opens a small RGB-slider popup — Slint's
// std-widgets has no built-in color picker, so this is a minimal in-app one.
//
// Hex-text <-> RGB conversion needs actual string/number formatting, which
// isn't available in the Slint language itself, so it's done on the Rust
// side: typing a hex value and pressing Enter fires `hex-committed`, which
// tagent-gui's main.rs parses and reflects back into `red`/`green`/`blue`.
component ColorPickerField {
    in property <string> label;
    in-out property <bool> use-default: true;
    in-out property <float> red: 0;
    in-out property <float> green: 0;
    in-out property <float> blue: 0;
    in-out property <string> hex-text: "";

    callback hex-committed(string);
    // Fired whenever a slider moves. Formatting red/green/blue as a "#RRGGBB"
    // string needs actual number formatting, which isn't available in the
    // Slint language, so main.rs handles it and writes the result back into
    // `hex-text` — otherwise the field would go stale while dragging sliders.
    callback rgb-changed();

    property <color> preview: rgb(red, green, blue);

    VerticalLayout {
        spacing: 4px;

        HorizontalLayout {
            spacing: 8px;
            Text { text: label; vertical-alignment: center; min-width: 90px; }
            CheckBox { text: "Theme default"; checked <=> use-default; }
        }

        if !use-default: HorizontalLayout {
            spacing: 6px;

            swatch := Rectangle {
                width: 24px;
                height: 24px;
                border-width: 1px;
                border-color: Palette.border;
                border-radius: 4px;
                background: preview;

                TouchArea {
                    clicked => { popup.show(); }
                }

                popup := PopupWindow {
                    x: 0px;
                    y: parent.height + 4px;
                    width: 160px;
                    height: 116px;
                    // Default close-policy is close-on-click, which would close
                    // the popup on every slider drag (a click on the slider's
                    // own track/thumb counts). Only auto-close on a click
                    // outside the popup, e.g. elsewhere in the dialog.
                    close-policy: PopupClosePolicy.close-on-click-outside;

                    Rectangle {
                        background: Palette.background;
                        border-width: 1px;
                        border-color: Palette.border;
                        border-radius: 4px;

                        VerticalBox {
                            padding: 8px;
                            spacing: 2px;

                            Text { text: "R"; font-size: 10px; }
                            Slider { minimum: 0; maximum: 255; value <=> red; changed => { rgb-changed(); } }
                            Text { text: "G"; font-size: 10px; }
                            Slider { minimum: 0; maximum: 255; value <=> green; changed => { rgb-changed(); } }
                            Text { text: "B"; font-size: 10px; }
                            Slider { minimum: 0; maximum: 255; value <=> blue; changed => { rgb-changed(); } }
                        }
                    }
                }
            }

            LineEdit {
                text <=> hex-text;
                width: 100px;
                placeholder-text: "#RRGGBB";
                accepted(text) => { hex-committed(text); }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Tagent";
    icon: @image-url("../assets/icons/tray.png");
    preferred-width: 480px;
    preferred-height: 480px;
    forward-focus: input-field;

    // Applies a theme string ("auto"/"light"/"dark") to this window's own
    // Palette instance (globals aren't shared between windows, so both
    // AppWindow and SettingsDialog need their own copy of this function).
    // A plain-string `public function` — rather than exposing `Palette` and
    // `ColorScheme` to Rust and calling `.set_color_scheme()` there directly —
    // keeps Rust off Slint's `private_unstable_api` path that
    // `slint::ColorScheme` otherwise resolves through.
    public function apply-theme(theme: string) {
        Palette.color-scheme = theme == "light" ? ColorScheme.light
            : theme == "dark" ? ColorScheme.dark
            : ColorScheme.unknown;
    }

    // Theme-adaptive tokens for the custom-drawn panels below (transcript,
    // input box). Palette's role properties already resolve correctly for
    // ColorScheme.dark/light/unknown(auto) — no manual branching needed here.
    // prompt-accent is the one exception: it's a decorative highlight with no
    // matching Palette role, so it branches on color-scheme directly.
    //
    // panel-background-theme-default/panel-foreground are read from Rust (as
    // `out` properties): the former to resolve panel-background itself (see
    // below), the input bar's own frame (which deliberately stays on the raw
    // theme value, never the customizable color — see its usage below), and
    // phrase-background/translation-background's "theme default" when the
    // user hasn't picked a custom value in Settings; panel-foreground for
    // phrase-color/translation-color's "theme default".
    property <brush> panel-border: Palette.border;
    out property <brush> panel-background-theme-default: Palette.alternate-background;
    out property <brush> panel-foreground: Palette.alternate-foreground;
    property <brush> field-background: Palette.control-background;
    property <brush> field-foreground: Palette.control-foreground;
    property <brush> selection-bg: Palette.selection-background;
    property <brush> selection-fg: Palette.selection-foreground;
    property <brush> prompt-accent: Palette.color-scheme == ColorScheme.light ? #92400e : #e5c07b;

    // The transcript log's background — "Background color" in Settings >
    // View. Empty config means "follow the theme"
    // (panel-background-theme-default); set from Rust, same resolution
    // pattern as phrase-background/translation-background.
    in-out property <color> panel-background: #000000;

    in-out property <string> input-text: "";
    in-out property <[TranscriptEntry]> transcript-entries: [];
    in-out property <[string]> languages: ["Auto", "English", "Russian", "Spanish", "French", "German"];
    in-out property <int> source-language-index: 0;
    in-out property <int> target-language-index: 2;

    // Independent display style for the phrase (original text) and
    // translation lines in the transcript — set from Rust based on
    // `tagent-gui.json`'s phrase-*/translation-* fields (see config.rs).
    in-out property <string> phrase-font: "monospace";
    in-out property <int> phrase-size: 13;
    in-out property <color> phrase-color: #000000;
    in-out property <color> phrase-background: #00000000;
    in-out property <string> translation-font: "monospace";
    in-out property <int> translation-size: 13;
    in-out property <color> translation-color: #000000;
    in-out property <color> translation-background: #00000000;

    // Vertical gap (px) between one phrase/translation pair and the next.
    in-out property <int> block-spacing-px: 20;
    // Vertical gap (px) between a phrase and its own translation, within one pair.
    in-out property <int> phrases-spacing-px: 2;

    // Height the user picked by dragging the resize handle; clamped and
    // combined with the wrapped text's natural height below.
    in-out property <length> input-user-height: 32px;
    property <length> input-min-height: 32px;
    property <length> input-max-height: 220px;
    property <length> input-box-height: max(input-min-height, min(input-max-height,
        max(input-user-height, input-field.preferred-height + 16px)));

    out property <length> transcript-viewport-height <=> transcript-scroll.viewport-height;
    out property <length> transcript-visible-height <=> transcript-scroll.visible-height;
    in-out property <length> transcript-viewport-y <=> transcript-scroll.viewport-y;

    callback translate-requested(string, string, string);
    callback swap-requested();
    callback settings-requested();
    callback copy-requested();

    VerticalBox {
        HorizontalBox {
            ComboBox {
                model: languages;
                current-index <=> source-language-index;
            }

            Button {
                text: "⇄";
                clicked => { swap-requested(); }
            }

            ComboBox {
                model: languages;
                current-index <=> target-language-index;
            }

            Rectangle { horizontal-stretch: 1; }

            Button {
                text: "⚙";
                clicked => { settings-requested(); }
            }
        }

        Rectangle {
            background: panel-background;
            border-radius: 4px;
            border-width: 1px;
            border-color: panel-border;
            vertical-stretch: 1;
            min-height: 60px;

            transcript-scroll := ScrollView {
                width: parent.width;
                height: parent.height;
                viewport-width: self.width;
                viewport-height: transcript-content.preferred-height + 16px;

                transcript-content := VerticalLayout {
                    x: 8px;
                    y: 8px;
                    width: parent.width - 16px;
                    spacing: block-spacing-px * 1px;
                    alignment: start;

                    Text {
                        text: "=== Tagent ===\nType text and press Enter to translate.\n\n";
                        font-family: "monospace";
                        font-size: 13px;
                        color: panel-foreground;
                        wrap: word-wrap;
                    }

                    for entry in transcript-entries: VerticalLayout {
                        spacing: phrases-spacing-px * 1px;

                        // No vertical padding anywhere in this pair — the gap
                        // between the phrase's last line and the
                        // translation's first line is entirely controlled by
                        // phrases-spacing-px, down to 0.
                        Rectangle {
                            background: phrase-background;
                            border-radius: 3px;
                            height: phrase-line.preferred-height;

                            phrase-line := TextInput {
                                text: entry.phrase;
                                font-family: phrase-font;
                                font-size: phrase-size * 1px;
                                color: phrase-color;
                                selection-background-color: selection-bg;
                                selection-foreground-color: selection-fg;
                                wrap: word-wrap;
                                single-line: false;
                                read-only: true;
                                horizontal-alignment: left;
                                vertical-alignment: top;
                                x: 4px;
                                y: 0px;
                                width: parent.width - 8px;
                                height: self.preferred-height;
                            }
                        }

                        Rectangle {
                            background: translation-background;
                            border-radius: 3px;
                            height: translation-line.preferred-height;

                            translation-line := TextInput {
                                text: entry.translation;
                                font-family: translation-font;
                                font-size: translation-size * 1px;
                                color: translation-color;
                                selection-background-color: selection-bg;
                                selection-foreground-color: selection-fg;
                                wrap: word-wrap;
                                single-line: false;
                                read-only: true;
                                horizontal-alignment: left;
                                vertical-alignment: top;
                                x: 4px;
                                y: 0px;
                                width: parent.width - 8px;
                                height: self.preferred-height;
                            }
                        }
                    }
                }
            }
        }

        resize-handle := Rectangle {
            height: 6px;

            Rectangle {
                width: 32px;
                height: 2px;
                border-radius: 1px;
                background: resize-touch.pressed ? panel-border.brighter(1.0) : resize-touch.has-hover ? panel-border.brighter(0.5) : panel-border;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            resize-touch := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: ns-resize;

                moved => {
                    if (self.pressed) {
                        input-user-height = max(input-min-height, min(input-max-height,
                            input-user-height - (self.mouse-y - self.pressed-y)));
                    }
                }
            }
        }

        Rectangle {
            // Deliberately the raw theme default, not the customizable
            // panel-background: this frame just holds the language prompt,
            // input field, and Translate button, and a custom "Background
            // color" bleeding through the gaps around them (behind the
            // prompt, behind the button) looked like the controls themselves
            // had been recolored. Only the transcript log's reading area
            // uses the customizable color.
            background: panel-background-theme-default;
            border-radius: 4px;
            border-width: 1px;
            border-color: panel-border;
            height: input-box-height;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 4px;
                alignment: stretch;

                Text {
                    text: "[" + languages[source-language-index] + "]:";
                    font-family: "monospace";
                    font-size: 13px;
                    color: prompt-accent;
                    vertical-alignment: center;
                }

                Rectangle {
                    background: field-background;
                    border-radius: 3px;
                    border-width: 1px;
                    border-color: panel-border;
                    horizontal-stretch: 1;

                    ScrollView {
                        width: parent.width;
                        height: parent.height;
                        viewport-width: self.width;
                        viewport-height: input-field.preferred-height + 16px;

                        input-field := TextInput {
                            text <=> input-text;
                            font-size: 13px;
                            color: field-foreground;
                            selection-background-color: selection-bg;
                            selection-foreground-color: selection-fg;
                            wrap: word-wrap;
                            single-line: false;
                            horizontal-alignment: left;
                            vertical-alignment: top;
                            x: 8px;
                            y: 8px;
                            width: parent.width - 16px;
                            height: max(self.preferred-height, parent.height - 16px);

                            key-pressed(event) => {
                                if (event.text == Key.Return && !event.modifiers.shift) {
                                    translate-requested(
                                        input-text,
                                        languages[source-language-index],
                                        languages[target-language-index],
                                    );
                                    input-text = "";
                                    return accept;
                                }
                                return reject;
                            }
                        }
                    }
                }

                Button {
                    text: "📋";
                    clicked => { copy-requested(); }
                }

                Button {
                    text: "Translate";
                    clicked => {
                        translate-requested(
                            input-text,
                            languages[source-language-index],
                            languages[target-language-index],
                        );
                        input-text = "";
                    }
                }
            }
        }
    }
}

// Stage 6: the hotkey-triggered popup shown next to the mouse cursor. A real
// top-level `Window` (not Slint's builtin `PopupWindow` element used above by
// ColorPickerField — that one is an anchored, parent-relative overlay with no
// OS-level frame/always-on-top control, not what a cursor-positioned,
// independently placed popup needs), so it can be `no-frame`/`always-on-top`
// and moved with `Window::set_position` from Rust. Named `TranslationPopup`
// specifically to avoid colliding with that builtin element name.
export component TranslationPopup inherits Window {
    no-frame: true;
    always-on-top: true;

    // Fixed width, reactive height: rather than leaving the window's own size
    // unbound and hoping the platform backend re-fits it to new content on
    // every show() (unverified — see the Stage 6 plan's sizing flag), the
    // height is explicitly bound to the content layout's preferred-height
    // (which already includes content-layout's own 8px top/bottom padding —
    // no extra margin added here), so Slint's normal reactive layout
    // recompute (the same mechanism that already resizes AppWindow's
    // transcript rows to wrapped text) drives the actual OS window size too.
    width: 360px;
    height: content-layout.preferred-height;

    // Same helper as AppWindow's/SettingsDialog's — this window has its own
    // separate Palette instance too.
    public function apply-theme(theme: string) {
        Palette.color-scheme = theme == "light" ? ColorScheme.light
            : theme == "dark" ? ColorScheme.dark
            : ColorScheme.unknown;
    }

    // Theme-derived defaults for phrase-color/translation-color/phrase-background/
    // translation-background when their config value is "" ("follow the theme") —
    // read from Rust as `out` properties, same pattern and same Palette roles as
    // AppWindow's own panel-foreground/panel-background-theme-default.
    out property <brush> panel-foreground: Palette.alternate-foreground;
    out property <brush> panel-background-theme-default: Palette.alternate-background;

    in property <string> phrase-text: "";
    in property <string> translation-text: "";
    in property <string> phrase-font: "monospace";
    in property <int> phrase-size: 13;
    in property <color> phrase-color: #000000;
    in property <color> phrase-background: #00000000;
    in property <string> translation-font: "monospace";
    in property <int> translation-size: 13;
    in property <color> translation-color: #000000;
    in property <color> translation-background: #00000000;

    // Auto-hide: entirely self-contained in this component via the `Timer`
    // *element* below (not Rust's `slint::Timer` API, which is `!Send` and so
    // can't be held by main.rs across the background thread its hotkey path
    // routes translation results through — see `show_popup`'s doc comment in
    // main.rs). `main.rs` only sets `auto-hide-seconds` and calls
    // `start-hide-timer()`; it finds out the popup is ready to close via
    // `hide-requested`, which just calls `popup.hide()` — no timer/threading
    // concerns on the Rust side at all.
    //
    // Hover detection itself (`touch-area.has-hover`) is also fully internal:
    // unlike tagent-cli's terminal-window popup (which has to poll
    // XQueryPointer/GetCursorPos plus window-geometry math from *outside* the
    // window it's tracking), this window owns its content directly, so
    // Slint's own hover tracking is enough — no platform code involved.
    in-out property <int> auto-hide-seconds: 3;
    callback hide-requested();

    hide-timer := Timer {
        interval: 3s;
        running: false;
        triggered => {
            if (touch-area.has-hover) {
                // Mirrors tagent-cli's `hide_terminal_and_restore` polling
                // loop (`translator.rs`): once the initial delay has passed,
                // keep re-checking every second for as long as the cursor
                // stays over the popup.
                self.interval = 1s;
                self.restart();
            } else {
                self.running = false;
                hide-requested();
            }
        }
    }

    // Called from Rust each time the popup is (re)shown. `running = true`
    // covers the never-started-yet case; `restart()` additionally resets the
    // countdown relative to *now* even if the timer was already running (a
    // second hotkey trigger while a previous popup is still visible must
    // restart the delay, not let the earlier schedule fire early and hide the
    // new popup out from under it).
    public function start-hide-timer() {
        hide-timer.interval = auto-hide-seconds * 1s;
        hide-timer.running = true;
        hide-timer.restart();
    }

    Rectangle {
        background: panel-background-theme-default;
        border-width: 1px;
        border-color: Palette.border;

        touch-area := TouchArea {
            width: 100%;
            height: 100%;
        }

        content-layout := VerticalLayout {
            padding: 8px;
            spacing: 4px;

            Rectangle {
                background: phrase-background;
                border-radius: 3px;
                height: phrase-line.preferred-height;

                phrase-line := Text {
                    text: phrase-text;
                    font-family: phrase-font;
                    font-size: phrase-size * 1px;
                    color: phrase-color;
                    wrap: word-wrap;
                    x: 4px;
                    width: parent.width - 8px;
                }
            }

            Rectangle {
                background: translation-background;
                border-radius: 3px;
                height: translation-line.preferred-height;

                translation-line := Text {
                    text: translation-text;
                    font-family: translation-font;
                    font-size: translation-size * 1px;
                    color: translation-color;
                    wrap: word-wrap;
                    x: 4px;
                    width: parent.width - 8px;
                }
            }
        }
    }
}

export component SettingsDialog inherits Dialog {
    title: "Settings";
    preferred-width: 460px;
    preferred-height: 460px;

    // Same helper as AppWindow's — see its doc comment. This dialog has its
    // own separate Palette instance, so it needs its own call to this too.
    public function apply-theme(theme: string) {
        Palette.color-scheme = theme == "light" ? ColorScheme.light
            : theme == "dark" ? ColorScheme.dark
            : ColorScheme.unknown;
    }

    in-out property <[string]> providers: ["google"];
    in-out property <int> provider-index: 0;
    in-out property <[string]> themes: ["Auto", "Light", "Dark"];
    in-out property <int> theme-index: 0;
    in-out property <string> app-version: "";

    // One-shot preset picker: selecting an entry (main.rs looks it up by
    // name) immediately fills in the background/phrase/translation color
    // fields below and switches Theme to match — it isn't itself a
    // persisted setting, just a bulk-fill shortcut for the individual color
    // pickers, which stay fully editable afterward.
    in-out property <[string]> color-scheme-options: [
        "Presets…", "Solarized Dark", "Solarized Light", "Dracula", "Nord",
        "Gruvbox Dark", "Monokai", "One Dark", "Tokyo Night", "Catppuccin Mocha",
        "Night Owl", "Ayu Dark", "GitHub Light", "Gruvbox Light", "Catppuccin Latte"
    ];
    in-out property <int> color-scheme-index: 0;
    callback color-scheme-selected <=> color-scheme-combo.selected;

    // Vertical gaps (px) in the transcript — mirror AppWindow's
    // block-spacing-px/phrases-spacing-px.
    in-out property <int> block-spacing-px: 20;
    in-out property <int> phrases-spacing-px: 2;

    // Font choices shared by the phrase and translation style pickers below;
    // main.rs maps index 0/1/2 to the "monospace"/"sans-serif"/"serif"
    // font-family strings actually applied on AppWindow.
    in-out property <[string]> font-options: ["Monospace", "Sans Serif", "Serif"];
    in-out property <int> phrase-font-index: 0;
    in-out property <int> phrase-size: 13;
    in-out property <int> translation-font-index: 0;
    in-out property <int> translation-size: 13;

    in-out property <bool> background-use-default <=> background-color-field.use-default;
    in-out property <float> background-red <=> background-color-field.red;
    in-out property <float> background-green <=> background-color-field.green;
    in-out property <float> background-blue <=> background-color-field.blue;
    in-out property <string> background-hex <=> background-color-field.hex-text;
    callback background-hex-committed <=> background-color-field.hex-committed;
    callback background-rgb-changed <=> background-color-field.rgb-changed;

    in-out property <bool> phrase-color-use-default <=> phrase-text-color-field.use-default;
    in-out property <float> phrase-color-red <=> phrase-text-color-field.red;
    in-out property <float> phrase-color-green <=> phrase-text-color-field.green;
    in-out property <float> phrase-color-blue <=> phrase-text-color-field.blue;
    in-out property <string> phrase-color-hex <=> phrase-text-color-field.hex-text;
    callback phrase-color-hex-committed <=> phrase-text-color-field.hex-committed;
    callback phrase-color-rgb-changed <=> phrase-text-color-field.rgb-changed;

    in-out property <bool> phrase-bg-use-default <=> phrase-bg-color-field.use-default;
    in-out property <float> phrase-bg-red <=> phrase-bg-color-field.red;
    in-out property <float> phrase-bg-green <=> phrase-bg-color-field.green;
    in-out property <float> phrase-bg-blue <=> phrase-bg-color-field.blue;
    in-out property <string> phrase-bg-hex <=> phrase-bg-color-field.hex-text;
    callback phrase-bg-hex-committed <=> phrase-bg-color-field.hex-committed;
    callback phrase-bg-rgb-changed <=> phrase-bg-color-field.rgb-changed;

    in-out property <bool> translation-color-use-default <=> translation-text-color-field.use-default;
    in-out property <float> translation-color-red <=> translation-text-color-field.red;
    in-out property <float> translation-color-green <=> translation-text-color-field.green;
    in-out property <float> translation-color-blue <=> translation-text-color-field.blue;
    in-out property <string> translation-color-hex <=> translation-text-color-field.hex-text;
    callback translation-color-hex-committed <=> translation-text-color-field.hex-committed;
    callback translation-color-rgb-changed <=> translation-text-color-field.rgb-changed;

    in-out property <bool> translation-bg-use-default <=> translation-bg-color-field.use-default;
    in-out property <float> translation-bg-red <=> translation-bg-color-field.red;
    in-out property <float> translation-bg-green <=> translation-bg-color-field.green;
    in-out property <float> translation-bg-blue <=> translation-bg-color-field.blue;
    in-out property <string> translation-bg-hex <=> translation-bg-color-field.hex-text;
    callback translation-bg-hex-committed <=> translation-bg-color-field.hex-committed;
    callback translation-bg-rgb-changed <=> translation-bg-color-field.rgb-changed;

    in-out property <bool> show-prompt: true;

    // Stage 8: the global hotkey string (Stage 5) and the popup auto-hide
    // delay (Stage 6), now editable here instead of only by hand in
    // tagent-gui.json. `translate-hotkey-error` is set from Rust (not
    // dialog-owned) after validating every edit via `hotkey-edited` --
    // non-empty disables the OK button below.
    in-out property <string> translate-hotkey: "Alt+Q";
    in property <string> translate-hotkey-error: "";
    callback hotkey-edited(string);
    in-out property <int> popup-auto-hide-seconds: 3;

    // Stage 7: whether the app launches straight into the tray with no window
    // shown. Default is `true`, and shipping that default with no in-app way
    // to turn it back off would be a dead end, hence a real control here.
    in-out property <bool> start-minimized: true;

    // Stage 7 follow-up: whether the main window's size/position are saved on
    // hide-to-tray/quit and restored the next time it's shown. The saved
    // x/y/width/height themselves aren't dialog-editable fields -- they're
    // captured automatically from the real window -- so only this on/off
    // toggle lives here, same "field before its own editor" split as
    // popup-delay/translate-hotkey above.
    in-out property <bool> remember-window-geometry: true;

    callback save-requested(string /* provider */, string /* theme */);

    // Tabbed layout: "General" holds the provider, "View" holds the theme
    // plus the phrase/translation display style, "Hotkeys & Tray" holds the
    // global hotkey, popup auto-hide delay, start-minimized and
    // remember-window-geometry toggles. Adding a category later means adding
    // another `Tab { ... }` here, not restructuring the dialog.
    TabWidget {
        Tab {
            title: "General";

            VerticalBox {
                alignment: start;

                Text { text: "Translate provider:"; }
                ComboBox {
                    model: providers;
                    current-index <=> provider-index;
                }
            }
        }

        Tab {
            title: "View";

            ScrollView {
                VerticalBox {
                    alignment: start;

                    Text { text: "Theme:"; }
                    ComboBox {
                        model: themes;
                        current-index <=> theme-index;
                    }

                    Text { text: "Color scheme:"; }
                    color-scheme-combo := ComboBox {
                        model: color-scheme-options;
                        current-index <=> color-scheme-index;
                    }

                    background-color-field := ColorPickerField { label: "Background color:"; }

                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Blocks spacing (px):"; vertical-alignment: center; }
                        SpinBox { minimum: 0; maximum: 200; value <=> block-spacing-px; }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Phrases spacing (px):"; vertical-alignment: center; }
                        SpinBox { minimum: 0; maximum: 100; value <=> phrases-spacing-px; }
                    }
                    CheckBox { text: "Show prompt"; checked <=> show-prompt; }

                    Text { text: "Phrase"; font-weight: 700; }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Font:"; vertical-alignment: center; }
                        ComboBox { model: font-options; current-index <=> phrase-font-index; }
                        Text { text: "Size:"; vertical-alignment: center; }
                        SpinBox { minimum: 8; maximum: 48; value <=> phrase-size; }
                    }
                    phrase-text-color-field := ColorPickerField { label: "Text color:"; }
                    phrase-bg-color-field := ColorPickerField { label: "Background:"; }

                    Text { text: "Translation"; font-weight: 700; }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Font:"; vertical-alignment: center; }
                        ComboBox { model: font-options; current-index <=> translation-font-index; }
                        Text { text: "Size:"; vertical-alignment: center; }
                        SpinBox { minimum: 8; maximum: 48; value <=> translation-size; }
                    }
                    translation-text-color-field := ColorPickerField { label: "Text color:"; }
                    translation-bg-color-field := ColorPickerField { label: "Background:"; }
                }
            }
        }

        Tab {
            title: "Hotkeys & Tray";

            VerticalBox {
                alignment: start;

                Text { text: "Global hotkey:"; }
                LineEdit {
                    text <=> translate-hotkey;
                    edited(text) => { hotkey-edited(text); }
                }
                Text {
                    text: translate-hotkey-error;
                    color: #e05252;
                    wrap: word-wrap;
                    visible: translate-hotkey-error != "";
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Popup auto-hide (seconds):"; vertical-alignment: center; }
                    SpinBox { minimum: 0; maximum: 60; value <=> popup-auto-hide-seconds; }
                    Text { text: "(0 = default 3s)"; vertical-alignment: center; }
                }

                CheckBox { text: "Start minimized to tray"; checked <=> start-minimized; }
                CheckBox {
                    text: "Remember window size and position";
                    checked <=> remember-window-geometry;
                }

                Text {
                    text: "The global hotkey takes effect only after restarting Tagent. The popup delay applies immediately; \"Start minimized\"/\"Remember window size and position\" apply the next time the window is shown or the app restarts.";
                    wrap: word-wrap;
                }
            }
        }

        Tab {
            title: "About";

            VerticalBox {
                alignment: start;

                Text { text: "Tagent"; font-weight: 700; }
                Text { text: "Version " + app-version; }
            }
        }
    }

    StandardButton {
        kind: ok;
        enabled: translate-hotkey-error == "";
        clicked => { save-requested(providers[provider-index], themes[theme-index]); }
    }
    StandardButton { kind: cancel; }
}

// Stage 7: system tray icon. One instance is created in main.rs and kept alive
// for the whole process lifetime -- per SystemTrayIcon's own docs, the icon
// appears as soon as the instance exists and an event loop is running, and
// disappears when the instance is dropped, so no `.show()`/`.hide()` call is
// needed (or wanted -- see below). Left-click and the "Show Tagent" menu item
// both just ask main.rs to reveal the main window; "Settings…" reuses the
// existing Settings dialog; "Quit" is now the only way to actually exit the
// app, since AppWindow's own close button (main.rs) is redirected to hide
// instead of quit.
export component TrayIcon inherits SystemTrayIcon {
    icon: @image-url("../assets/icons/tray.png");
    tooltip: "Tagent";

    callback show-requested();
    callback settings-requested();
    callback quit-requested();

    clicked => { show-requested(); }

    Menu {
        MenuItem { title: "Show Tagent"; activated => { show-requested(); } }
        MenuItem { title: "Settings…"; activated => { settings-requested(); } }
        MenuSeparator {}
        MenuItem { title: "Quit"; activated => { quit-requested(); } }
    }
}
