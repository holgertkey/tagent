import { Button, CheckBox, ComboBox, LineEdit, Palette, ScrollView, Slider, SpinBox, StandardButton, TabWidget, VerticalBox, HorizontalBox } from "std-widgets.slint";

// One translation round-trip in the transcript: the original phrase and its
// translation (or an error message), each rendered with its own independently
// configurable font/size/color/background — see AppWindow's phrase-*/translation-*
// style properties below. The transcript is view-only (Stage 13): each block
// renders as a `StyledText` bound to its `*-styled` field below, not a
// selectable `TextInput` -- there is no mouse selection or Ctrl+C in the
// transcript any more, only a right-click "Copy" menu per block (see
// `copy-block-requested`).
export struct TranscriptEntry {
    phrase: string,
    translation: string,
    // Stage 10: `phrase`/`translation` above stay exactly as before (the
    // prompt-formatted display strings) -- these four carry what the
    // per-entry text-to-speech buttons actually need, since the display
    // strings already have a "[Russian]:"-style prompt baked in and can't be
    // spoken as-is, and there's otherwise no language code stored on the
    // entry at all.
    //
    // phrase-speech is the raw, unprompted phrase text. translation-speech is
    // the raw *primary* translation only -- for a Stage 9 dictionary hit this
    // is just the header line (see dictionary::primary_line), never the full
    // formatted block (part-of-speech headers, synonym lists), which would
    // read strangely out loud.
    phrase-speech: string,
    translation-speech: string,
    // from-code may be "auto" (resolved lazily at speak time); to-code never
    // is, since "Auto" as a target is already rejected before translation
    // happens.
    from-code: string,
    to-code: string,
    // Hides the translation speaker button for a failed translation without
    // also hiding the (always-valid) phrase one.
    translation-is-error: bool,
    // Stage 13: semantic highlighting. `phrase`/`translation` above are kept as
    // a plain-text fallback (currently unrendered) rather than deleted -- see
    // `.debug/tagent-gui development plan.md`'s Stage 13 open item 4.
    //
    // `*-template` is markdown with role-tagged `<font color="@role">` spans
    // (never a literal color -- see `tagent-gui/src/styled.rs`), kept
    // alongside the already-rendered `*-styled` value so a theme change can
    // re-render it without needing the original text again (`main.rs`'s
    // `restyle_transcript`). `*-styled` is what the `StyledText` elements
    // below actually bind to. `*-copy` is the plain text (no prefix, no
    // markup) the right-click "Copy" menu item for that block copies.
    phrase-template: string,
    translation-template: string,
    phrase-styled: styled-text,
    translation-styled: styled-text,
    phrase-copy: string,
    translation-copy: string,
}

// Reusable "theme default, or pick a color" field used four times in
// SettingsDialog's View tab (phrase text/background, translation
// text/background). Combines a HEX text field (for typing an exact value)
// with a swatch button that opens a small RGB-slider popup — Slint's
// std-widgets has no built-in color picker, so this is a minimal in-app one.
//
// Hex-text <-> RGB conversion needs actual string/number formatting, which
// isn't available in the Slint language itself, so it's done on the Rust
// side: typing a hex value and pressing Enter fires `hex-committed`, which
// tagent-gui's main.rs parses and reflects back into `red`/`green`/`blue`.
component ColorPickerField {
    in property <string> label;
    in-out property <bool> use-default: true;
    in-out property <float> red: 0;
    in-out property <float> green: 0;
    in-out property <float> blue: 0;
    in-out property <string> hex-text: "";

    callback hex-committed(string);
    // Fired whenever a slider moves. Formatting red/green/blue as a "#RRGGBB"
    // string needs actual number formatting, which isn't available in the
    // Slint language, so main.rs handles it and writes the result back into
    // `hex-text` — otherwise the field would go stale while dragging sliders.
    callback rgb-changed();

    property <color> preview: rgb(red, green, blue);

    VerticalLayout {
        spacing: 4px;

        HorizontalLayout {
            spacing: 8px;
            Text { text: label; vertical-alignment: center; min-width: 90px; }
            CheckBox { text: "Theme default"; checked <=> use-default; }
        }

        if !use-default: HorizontalLayout {
            spacing: 6px;

            swatch := Rectangle {
                width: 24px;
                height: 24px;
                border-width: 1px;
                border-color: Palette.border;
                border-radius: 4px;
                background: preview;

                TouchArea {
                    clicked => { popup.show(); }
                }

                popup := PopupWindow {
                    x: 0px;
                    y: parent.height + 4px;
                    width: 160px;
                    height: 116px;
                    // Default close-policy is close-on-click, which would close
                    // the popup on every slider drag (a click on the slider's
                    // own track/thumb counts). Only auto-close on a click
                    // outside the popup, e.g. elsewhere in the dialog.
                    close-policy: PopupClosePolicy.close-on-click-outside;

                    Rectangle {
                        background: Palette.background;
                        border-width: 1px;
                        border-color: Palette.border;
                        border-radius: 4px;

                        VerticalBox {
                            padding: 8px;
                            spacing: 2px;

                            Text { text: "R"; font-size: 10px; }
                            Slider { minimum: 0; maximum: 255; value <=> red; changed => { rgb-changed(); } }
                            Text { text: "G"; font-size: 10px; }
                            Slider { minimum: 0; maximum: 255; value <=> green; changed => { rgb-changed(); } }
                            Text { text: "B"; font-size: 10px; }
                            Slider { minimum: 0; maximum: 255; value <=> blue; changed => { rgb-changed(); } }
                        }
                    }
                }
            }

            LineEdit {
                text <=> hex-text;
                width: 100px;
                placeholder-text: "#RRGGBB";
                accepted(text) => { hex-committed(text); }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Tagent";
    icon: @image-url("../assets/icons/tray.png");
    preferred-width: 480px;
    preferred-height: 480px;
    forward-focus: input-field;

    // Applies a theme string ("auto"/"light"/"dark") to this window's own
    // Palette instance (globals aren't shared between windows, so both
    // AppWindow and SettingsDialog need their own copy of this function).
    // A plain-string `public function` — rather than exposing `Palette` and
    // `ColorScheme` to Rust and calling `.set_color_scheme()` there directly —
    // keeps Rust off Slint's `private_unstable_api` path that
    // `slint::ColorScheme` otherwise resolves through.
    public function apply-theme(theme: string) {
        Palette.color-scheme = theme == "light" ? ColorScheme.light
            : theme == "dark" ? ColorScheme.dark
            : ColorScheme.unknown;
    }

    // Theme-adaptive tokens for the custom-drawn panels below (transcript,
    // input box). Palette's role properties already resolve correctly for
    // ColorScheme.dark/light/unknown(auto) — no manual branching needed here.
    // prompt-accent-theme-default is the one exception: it's a decorative
    // highlight with no matching Palette role, so it branches on color-scheme
    // directly.
    //
    // panel-background-theme-default/panel-foreground are read from Rust (as
    // `out` properties): the former to resolve panel-background itself (see
    // below), the input bar's own frame (which deliberately stays on the raw
    // theme value, never the customizable color — see its usage below), and
    // phrase-background/translation-background's "theme default" when the
    // user hasn't picked a custom value in Settings; panel-foreground for
    // phrase-color/translation-color's "theme default".
    property <brush> panel-border: Palette.border;
    out property <brush> panel-background-theme-default: Palette.alternate-background;
    out property <brush> panel-foreground: Palette.alternate-foreground;
    property <brush> field-background: Palette.control-background;
    property <brush> field-foreground: Palette.control-foreground;
    property <brush> selection-bg: Palette.selection-background;
    property <brush> selection-fg: Palette.selection-foreground;
    // prompt-accent-theme-default is prompt-color's "theme default" (an empty
    // config value), read from Rust the same way panel-background-theme-default
    // is; prompt-accent itself is the resolved value Rust actually sets (custom
    // hex, or this default), same pattern as phrase-color/translation-color --
    // configurable since the "prompt color" Settings feature (2026-09-22).
    out property <brush> prompt-accent-theme-default: Palette.color-scheme == ColorScheme.light ? #92400e : #e5c07b;
    in-out property <color> prompt-accent: #92400e;

    // The transcript log's background — "Background color" in Settings >
    // View. Empty config means "follow the theme"
    // (panel-background-theme-default); set from Rust, same resolution
    // pattern as phrase-background/translation-background.
    in-out property <color> panel-background: #000000;

    // Transcript header ("=== Tagent vX ===" plus the active hotkeys). The two
    // hotkey properties are set once from Rust, at startup, to the hotkeys the
    // keyboard hook actually registered (empty = not registered, so no line);
    // the speech line additionally follows tts-enabled, which is live.
    in-out property <string> app-version: "";
    in-out property <string> active-translate-hotkey: "";
    in-out property <string> active-speech-hotkey: "";
    property <string> header-text: "=== Tagent v" + app-version + " ===\nType text and press Enter to translate."
        + (active-translate-hotkey != ""
            ? "\n\nActive Hotkeys:\n  Translation: " + active-translate-hotkey
                + (active-speech-hotkey != "" && tts-enabled ? "\n  Speech: " + active-speech-hotkey : "")
            : "")
        + "\n\n";

    in-out property <string> input-text: "";
    in-out property <[TranscriptEntry]> transcript-entries: [];
    in-out property <[string]> languages: ["Auto", "English", "Russian", "Spanish", "French", "German"];
    in-out property <int> source-language-index: 0;
    in-out property <int> target-language-index: 2;

    // Independent display style for the phrase (original text) and
    // translation lines in the transcript — set from Rust based on
    // `tagent-gui.json`'s phrase-*/translation-* fields (see config.rs).
    in-out property <string> phrase-font: "monospace";
    in-out property <int> phrase-size: 13;
    in-out property <color> phrase-color: #000000;
    in-out property <color> phrase-background: #00000000;
    in-out property <string> translation-font: "monospace";
    in-out property <int> translation-size: 13;
    in-out property <color> translation-color: #000000;
    in-out property <color> translation-background: #00000000;

    // Vertical gap (px) between one phrase/translation pair and the next.
    in-out property <int> block-spacing-px: 20;
    // Vertical gap (px) between a phrase and its own translation, within one pair.
    in-out property <int> phrases-spacing-px: 2;

    // Height the user picked by dragging the resize handle; clamped and
    // combined with the wrapped text's natural height below.
    in-out property <length> input-user-height: 32px;
    property <length> input-min-height: 32px;
    property <length> input-max-height: 220px;
    property <length> input-box-height: max(input-min-height, min(input-max-height,
        max(input-user-height, input-field.preferred-height + 16px)));

    out property <length> transcript-viewport-height <=> transcript-scroll.viewport-height;
    out property <length> transcript-visible-height <=> transcript-scroll.visible-height;
    in-out property <length> transcript-viewport-y <=> transcript-scroll.viewport-y;

    // Keeps the transcript pinned to its end. Done here, from `changed`
    // handlers, rather than by Rust right after it pushes an entry: the
    // `for` rows below are only instantiated (and their wrapped text
    // measured) on the next layout pass, so `viewport-height` read straight
    // after the model changes is still the *previous* height and the view
    // stopped one entry short of the bottom. These fire once the new height
    // is real -- and also when the visible height changes (dragging the
    // input resize handle) or the text re-wraps (window resize).
    function scroll-to-transcript-end() {
        transcript-viewport-y = min(0px, transcript-visible-height - transcript-viewport-height);
    }
    changed transcript-viewport-height => { scroll-to-transcript-end(); }
    changed transcript-visible-height => { scroll-to-transcript-end(); }

    // Stage 10: whether the per-entry text-to-speech speaker buttons render
    // at all -- gated by tagent-gui.json's enable_text_to_speech.
    in-out property <bool> tts-enabled: true;
    // Which transcript row (by index into transcript-entries) is currently
    // speaking, and whether it's the phrase or translation side -- one
    // shared pair of properties, not per-entry state, since only one Sink
    // ever plays at a time (mirroring tagent-cli's own single-Sink design).
    // -1 means nothing is speaking.
    in-out property <int> speaking-entry-index: -1;
    in-out property <bool> speaking-is-phrase: true;
    callback speak-requested(int, bool);

    callback translate-requested(string, string, string);
    callback swap-requested();
    callback settings-requested();
    callback copy-requested();
    // Stage 13: right-click "Copy" on one transcript block -- index into
    // transcript-entries, then true for the phrase block / false for the
    // translation block. Deliberately not named copy-requested (above),
    // which is the unrelated 📋 "paste clipboard into input" button.
    callback copy-block-requested(int, bool);
    // Whether right-click opens the "Copy" context menu (`ContextMenuArea` below)
    // or copies the block immediately with no menu at all -- `show_context_menu` in
    // tagent-gui.json, default off (a single-item menu is pure friction over just
    // copying directly). Live-reloaded, no restart needed.
    in-out property <bool> show-context-menu: false;
    // Feedback for the no-menu path, where nothing else indicates a copy just
    // happened (the menu path's own click-to-close is already visible on its own,
    // so this is never set there) -- a brief colored outline on the copied block,
    // animated back to nothing. -1 means nothing is flashing.
    in-out property <int> copy-flash-index: -1;
    in-out property <bool> copy-flash-is-phrase: true;
    flash-timer := Timer {
        interval: 220ms;
        running: copy-flash-index != -1;
        triggered => { copy-flash-index = -1; }
    }

    VerticalBox {
        HorizontalBox {
            ComboBox {
                model: languages;
                current-index <=> source-language-index;
            }

            Button {
                text: "⇄";
                clicked => { swap-requested(); }
            }

            ComboBox {
                model: languages;
                current-index <=> target-language-index;
            }

            Rectangle { horizontal-stretch: 1; }

            Button {
                text: "⚙";
                clicked => { settings-requested(); }
            }
        }

        Rectangle {
            background: panel-background;
            border-radius: 4px;
            border-width: 1px;
            border-color: panel-border;
            vertical-stretch: 1;
            min-height: 60px;

            transcript-scroll := ScrollView {
                width: parent.width;
                height: parent.height;
                viewport-width: self.width;
                viewport-height: transcript-content.preferred-height + 16px;

                transcript-content := VerticalLayout {
                    x: 8px;
                    y: 8px;
                    width: parent.width - 16px;
                    spacing: block-spacing-px * 1px;
                    alignment: start;

                    Text {
                        text: header-text;
                        font-family: "monospace";
                        font-size: 13px;
                        color: panel-foreground;
                        wrap: word-wrap;
                    }

                    for entry[i] in transcript-entries: VerticalLayout {
                        spacing: phrases-spacing-px * 1px;

                        // No vertical padding anywhere in this pair — the gap
                        // between the phrase's last line and the
                        // translation's first line is entirely controlled by
                        // phrases-spacing-px, down to 0.
                        HorizontalLayout {
                            spacing: 4px;

                            Rectangle {
                                horizontal-stretch: 1;
                                background: phrase-background;
                                border-radius: 3px;
                                height: phrase-line.preferred-height;
                                border-width: (copy-flash-index == i && copy-flash-is-phrase) ? 2px : 0px;
                                border-color: prompt-accent;
                                animate border-width { duration: 220ms; easing: ease-out; }

                                // Stage 13: view-only, no selection/Ctrl+C -- see
                                // TranscriptEntry's own comment. Copying is
                                // right-click, either via a "Copy" menu or directly
                                // (show-context-menu below) -- of the block's plain
                                // `phrase-copy` text.
                                phrase-line := StyledText {
                                    text: entry.phrase-styled;
                                    default-color: phrase-color;
                                    default-font-family: phrase-font;
                                    default-font-size: phrase-size * 1px;
                                    horizontal-alignment: left;
                                    vertical-alignment: top;
                                    x: 4px;
                                    y: 0px;
                                    width: parent.width - 8px;
                                    height: self.preferred-height;
                                }

                                if show-context-menu: ContextMenuArea {
                                    Menu {
                                        MenuItem {
                                            title: "Copy";
                                            enabled: entry.phrase-copy != "";
                                            activated => { copy-block-requested(i, true); }
                                        }
                                    }
                                }

                                // No-menu path: right-click copies immediately and
                                // flashes the block's border instead of opening a
                                // menu (see show-context-menu/copy-flash-index above).
                                if !show-context-menu: TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    pointer-event(event) => {
                                        if event.button == PointerEventButton.right
                                            && event.kind == PointerEventKind.up
                                            && entry.phrase-copy != "" {
                                            copy-flash-index = i;
                                            copy-flash-is-phrase = true;
                                            copy-block-requested(i, true);
                                        }
                                    }
                                }
                            }

                            // Stage 10: every row's button other than the one
                            // currently speaking is disabled (std-widgets'
                            // own dimmed/non-clickable styling) while
                            // speaking-entry-index != -1, rather than letting
                            // a second click start a second, overlapping
                            // Sink. The active row's own button stays
                            // enabled and turns into "⏹" -- clicking it again
                            // is how playback is stopped.
                            if tts-enabled && entry.phrase-speech != "": Button {
                                width: 28px;
                                text: (speaking-entry-index == i && speaking-is-phrase) ? "⏹" : "🔊";
                                enabled: speaking-entry-index == -1 || (speaking-entry-index == i && speaking-is-phrase);
                                clicked => { speak-requested(i, true); }
                            }
                        }

                        HorizontalLayout {
                            spacing: 4px;

                            Rectangle {
                                horizontal-stretch: 1;
                                background: translation-background;
                                border-radius: 3px;
                                height: translation-line.preferred-height;
                                border-width: (copy-flash-index == i && !copy-flash-is-phrase) ? 2px : 0px;
                                border-color: prompt-accent;
                                animate border-width { duration: 220ms; easing: ease-out; }

                                // Stage 13: see phrase-line's own comment above.
                                translation-line := StyledText {
                                    text: entry.translation-styled;
                                    default-color: translation-color;
                                    default-font-family: translation-font;
                                    default-font-size: translation-size * 1px;
                                    horizontal-alignment: left;
                                    vertical-alignment: top;
                                    x: 4px;
                                    y: 0px;
                                    width: parent.width - 8px;
                                    height: self.preferred-height;
                                }

                                if show-context-menu: ContextMenuArea {
                                    Menu {
                                        MenuItem {
                                            title: "Copy";
                                            enabled: entry.translation-copy != "";
                                            activated => { copy-block-requested(i, false); }
                                        }
                                    }
                                }

                                if !show-context-menu: TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    pointer-event(event) => {
                                        if event.button == PointerEventButton.right
                                            && event.kind == PointerEventKind.up
                                            && entry.translation-copy != "" {
                                            copy-flash-index = i;
                                            copy-flash-is-phrase = false;
                                            copy-block-requested(i, false);
                                        }
                                    }
                                }
                            }

                            if tts-enabled && !entry.translation-is-error && entry.translation-speech != "": Button {
                                width: 28px;
                                text: (speaking-entry-index == i && !speaking-is-phrase) ? "⏹" : "🔊";
                                enabled: speaking-entry-index == -1 || (speaking-entry-index == i && !speaking-is-phrase);
                                clicked => { speak-requested(i, false); }
                            }
                        }
                    }
                }
            }
        }

        resize-handle := Rectangle {
            height: 6px;

            Rectangle {
                width: 32px;
                height: 2px;
                border-radius: 1px;
                background: resize-touch.pressed ? panel-border.brighter(1.0) : resize-touch.has-hover ? panel-border.brighter(0.5) : panel-border;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            resize-touch := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: ns-resize;

                moved => {
                    if (self.pressed) {
                        input-user-height = max(input-min-height, min(input-max-height,
                            input-user-height - (self.mouse-y - self.pressed-y)));
                    }
                }
            }
        }

        Rectangle {
            // Deliberately the raw theme default, not the customizable
            // panel-background: this frame just holds the language prompt,
            // input field, and Translate button, and a custom "Background
            // color" bleeding through the gaps around them (behind the
            // prompt, behind the button) looked like the controls themselves
            // had been recolored. Only the transcript log's reading area
            // uses the customizable color.
            background: panel-background-theme-default;
            border-radius: 4px;
            border-width: 1px;
            border-color: panel-border;
            height: input-box-height;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 4px;
                alignment: stretch;

                Text {
                    text: "[" + languages[source-language-index] + "]:";
                    font-family: "monospace";
                    font-size: 13px;
                    color: prompt-accent;
                    vertical-alignment: center;
                }

                Rectangle {
                    background: field-background;
                    border-radius: 3px;
                    border-width: 1px;
                    border-color: panel-border;
                    horizontal-stretch: 1;

                    ScrollView {
                        width: parent.width;
                        height: parent.height;
                        viewport-width: self.width;
                        viewport-height: input-field.preferred-height + 16px;

                        input-field := TextInput {
                            text <=> input-text;
                            font-size: 13px;
                            color: field-foreground;
                            selection-background-color: selection-bg;
                            selection-foreground-color: selection-fg;
                            wrap: word-wrap;
                            single-line: false;
                            horizontal-alignment: left;
                            vertical-alignment: top;
                            x: 8px;
                            y: 8px;
                            width: parent.width - 16px;
                            height: max(self.preferred-height, parent.height - 16px);

                            key-pressed(event) => {
                                if (event.text == Key.Return && !event.modifiers.shift) {
                                    translate-requested(
                                        input-text,
                                        languages[source-language-index],
                                        languages[target-language-index],
                                    );
                                    input-text = "";
                                    return accept;
                                }
                                return reject;
                            }
                        }
                    }
                }

                Button {
                    text: "📋";
                    clicked => { copy-requested(); }
                }

                Button {
                    text: "Translate";
                    clicked => {
                        translate-requested(
                            input-text,
                            languages[source-language-index],
                            languages[target-language-index],
                        );
                        input-text = "";
                    }
                }
            }
        }
    }
}

// Stage 6: the hotkey-triggered popup shown next to the mouse cursor. A real
// top-level `Window` (not Slint's builtin `PopupWindow` element used above by
// ColorPickerField — that one is an anchored, parent-relative overlay with no
// OS-level frame/always-on-top control, not what a cursor-positioned,
// independently placed popup needs), so it can be `no-frame`/`always-on-top`
// and moved with `Window::set_position` from Rust. Named `TranslationPopup`
// specifically to avoid colliding with that builtin element name.
export component TranslationPopup inherits Window {
    no-frame: true;
    always-on-top: true;

    // Reactive-but-capped width and height: rather than leaving the window's
    // own size unbound and hoping the platform backend re-fits it to new
    // content on every show() (unverified — see the Stage 6 plan's sizing
    // flag), both dimensions are explicitly bound to what the content
    // actually needs, each capped at its own popup-max-*. Width shrinks to
    // fit the longer of the phrase/translation's natural (unwrapped)
    // single-line width, via `phrase-measure`/`translation-measure`'s own
    // `preferred-width` (a Text's preferred-width reflects its natural
    // unwrapped size regardless of the `wrap`/`width` it's actually given,
    // so this doesn't depend on how wide the window currently is) — text
    // only wraps once that natural width would exceed popup-max-width.
    // These two invisible plain-`Text` twins measure width deliberately
    // instead of the real, visible `phrase-line`/`translation-line`
    // (`StyledText` since the prompt-highlighting feature, 2026-09-22):
    // whether `StyledText.preferred-width` has this same "ignores my own
    // `width` binding" behavior is unverified, and a wrong guess here would
    // make the popup's own width-fitting feed back on itself, so measurement
    // stays on the widget this comment's claim is actually proven for.
    // Height is bound to the content layout's preferred-height (which
    // already includes content-layout's own 8px top/bottom padding — no
    // extra margin added here), so Slint's normal reactive layout recompute
    // (the same mechanism that already resizes AppWindow's transcript rows
    // to wrapped text) drives the actual OS window size too. Content taller
    // than the cap scrolls instead of growing the window further (Stage 9
    // follow-up) — see the ScrollView wrapping content-layout below.
    //
    // popup-horizontal-chrome accounts for content-layout's own 8px+8px
    // padding plus phrase-line/translation-line's own 4px+4px inset
    // (`x: 4px; width: parent.width - 8px`) — the gap between a line's
    // natural text width and the window width that comfortably fits it
    // without wrapping.
    property <length> popup-horizontal-chrome: 24px;
    property <length> phrase-natural-width: show-phrase ? phrase-measure.preferred-width : 0px;
    property <length> content-natural-width: max(phrase-natural-width, translation-measure.preferred-width) + popup-horizontal-chrome;

    width: max(min(content-natural-width, popup-max-width * 1px), 150px);
    height: min(content-layout.preferred-height, popup-max-height * 1px);

    // Invisible measurement-only twin of phrase-line: the real phrase-line
    // element lives inside `if show-phrase: Rectangle { ... }` below, so its id
    // isn't reliably queryable from this component's root scope when
    // show-phrase is false (the element doesn't exist in the tree at all in
    // that case). This one always exists, mirrors phrase-text/popup-font/
    // popup-size exactly, and is never actually rendered or laid out
    // (`visible: false`, not placed inside any Layout element).
    phrase-measure := Text {
        visible: false;
        text: phrase-text;
        font-family: popup-font;
        font-size: popup-size * 1px;
    }

    // Same reasoning as phrase-measure, for translation-line -- it's always
    // shown (no `if`), so this one is purely about the StyledText-vs-Text
    // preferred-width question above, not about an id that might not exist.
    translation-measure := Text {
        visible: false;
        text: translation-text;
        font-family: popup-font;
        font-size: popup-size * 1px;
    }

    // Same helper as AppWindow's/SettingsDialog's — this window has its own
    // separate Palette instance too.
    public function apply-theme(theme: string) {
        Palette.color-scheme = theme == "light" ? ColorScheme.light
            : theme == "dark" ? ColorScheme.dark
            : ColorScheme.unknown;
    }

    // Theme-derived defaults for popup-color/popup-background when their
    // config value is "" ("follow the theme") — read from Rust as `out`
    // properties, same pattern and same Palette roles as AppWindow's own
    // panel-foreground/panel-background-theme-default.
    out property <brush> panel-foreground: Palette.alternate-foreground;
    out property <brush> panel-background-theme-default: Palette.alternate-background;
    // popup-prompt-accent-theme-default is popup-prompt-color's own "follow
    // the theme" fallback -- same Palette-branching shape as AppWindow's
    // prompt-accent-theme-default (this window has its own Palette instance,
    // so it can't just read AppWindow's). Rust actually chains
    // popup_prompt_color -> prompt_color -> this, mirroring how
    // popup-color/popup-background already chain through translation-color/
    // translation-background (main.rs's apply_popup_style).
    out property <brush> popup-prompt-accent-theme-default: Palette.color-scheme == ColorScheme.light ? #92400e : #e5c07b;
    in property <color> popup-prompt-accent: #92400e;

    in property <string> phrase-text: "";
    in property <string> translation-text: "";
    // Right-click copy (2026-09-22, redesigned twice same day). `phrase-copy`/
    // `translation-copy` are the plain, unprompted text to copy -- exactly
    // `TranslationOutcome.phrase_raw`/`translation_raw`, already raw, so
    // `show_popup` sets these with no extra derivation.
    //
    // First version (a `show-context-menu`-gated choice between a popup-wide
    // `ContextMenuArea`+`Menu` and extending the drag `touch-area`'s own
    // `pointer-event`) didn't work live: with the menu on, it opened immediately
    // when the popup appeared, not on right-click, and was clipped on a small
    // popup; with it off, right-click copied nothing. Replaced outright, no menu
    // at all any more (the transcript's `show_context_menu` has no effect on the
    // popup) -- a `TouchArea` inside each of the phrase/translation `Rectangle`s
    // below, right-button-up triggers `popup-copy-requested` for that block.
    //
    // That meant a new nested interactive element over the same text `touch-area`
    // used for drag-by-any-point-of-the-surface, and dragging was temporarily
    // disabled outright rather than ship a half-working compromise. Restored the
    // same day, gated behind Ctrl (a plain left-click-drag would have re-created
    // the exact conflict this whole redesign exists to avoid, since a plain left
    // press on one of these `TouchArea`s is indistinguishable from one meant to
    // start a drag): the drag logic lives in these same two `TouchArea`s now
    // (not `touch-area`, which no longer receives any events over the text), on
    // `event.modifiers.control` -- see each block's own `TouchArea` below. Drag
    // only works from the two blocks, not `touch-area`'s own thin margin
    // (`content-layout`'s 8px padding plus the popup's border) -- a deliberately
    // accepted, minor gap rather than tripling this same logic into a third
    // place for a sliver of surface.
    in property <string> phrase-copy: "";
    in property <string> translation-copy: "";
    // Feedback since there's no menu-click to see: a brief colored outline on
    // the copied block, same shape as the transcript's own copy-flash-index but
    // split into two properties (no index needed -- exactly one phrase and one
    // translation block).
    in-out property <bool> copy-flash-active: false;
    in-out property <bool> copy-flash-is-phrase: true;
    popup-copy-flash-timer := Timer {
        interval: 220ms;
        running: copy-flash-active;
        triggered => { copy-flash-active = false; }
    }
    // true = phrase, false = translation.
    callback popup-copy-requested(bool);
    // Stage 13-style semantic highlighting: rendered `styled-text` values
    // `phrase-line`/`translation-line` actually bind to, built in Rust from the
    // same role-tagged templates the transcript's own entries use (prompt
    // prefix, plus a dictionary hit's part-of-speech/synonym/notice spans and
    // error rows). The templates themselves are kept here too so Rust's
    // `restyle_popup` can re-render them after a theme/color change.
    // phrase-text/translation-text above stay as the plain, unstyled strings --
    // still needed by phrase-measure/translation-measure for width measurement.
    in property <string> phrase-template: "";
    in property <string> translation-template: "";
    in property <styled-text> phrase-styled;
    in property <styled-text> translation-styled;
    // One shared style for both the phrase and translation lines — unlike
    // the main window's transcript, which styles them separately.
    in property <string> popup-font: "monospace";
    in property <int> popup-size: 13;
    in property <color> popup-color: #000000;
    in property <color> popup-background: #00000000;
    // Whether the phrase line renders at all -- the "[Auto]:"/"[Russian]:"
    // prompt itself is baked directly into phrase-text/translation-text by
    // main.rs (see format_line's doc comment), so it needs no property here.
    in property <bool> show-phrase: true;
    // Size cap (Stage 9 follow-up): the popup's width is always exactly
    // popup-max-width (text wraps to fit within it); popup-max-height
    // instead caps a dimension that otherwise grows with content, so it's a
    // true "won't exceed" cap, with the ScrollView below taking over once
    // content is taller than it.
    in property <int> popup-max-width: 600;
    in property <int> popup-max-height: 600;
    // Border thickness (px) of the popup's outer panel; color stays theme-derived
    // (Palette.border) regardless.
    in property <int> popup-border-width: 1;

    // Auto-hide: entirely self-contained in this component via the `Timer`
    // *element* below (not Rust's `slint::Timer` API, which is `!Send` and so
    // can't be held by main.rs across the background thread its hotkey path
    // routes translation results through — see `show_popup`'s doc comment in
    // main.rs). `main.rs` only sets `auto-hide-seconds` and calls
    // `start-hide-timer()`; it finds out the popup is ready to close via
    // `hide-requested`, which just calls `popup.hide()` — no timer/threading
    // concerns on the Rust side at all.
    //
    // Hover detection itself (`touch-area.has-hover`) is also fully internal:
    // unlike tagent-cli's terminal-window popup (which has to poll
    // XQueryPointer/GetCursorPos plus window-geometry math from *outside* the
    // window it's tracking), this window owns its content directly, so
    // Slint's own hover tracking is enough — no platform code involved.
    in-out property <int> auto-hide-seconds: 3;
    callback hide-requested();

    // Dragging the popup by any point of its surface (it has no buttons, and its
    // text isn't selectable, so nothing else competes for the press). The window
    // itself is moved from Rust (`wire_popup_drag` in main.rs) -- Slint can't
    // set a window's position from .slint -- and Rust follows the pointer using
    // global screen coordinates, so these carry no payload. `drag-ended` also
    // fires for a plain click; Rust tells the two apart by how far the pointer
    // travelled in between.
    callback drag-started();
    callback drag-moved();
    callback drag-ended();

    hide-timer := Timer {
        interval: 3s;
        running: false;
        triggered => {
            // `pressed` as well as `has-hover`: while the button is held for a
            // drag the pointer is grabbed, and hover tracking over this
            // TouchArea is not reliable in that state (same grab that made
            // wheel-scrolling report "not hovering", see `scroll-event` below).
            if (touch-area.has-hover || touch-area.pressed) {
                // Mirrors tagent-cli's `hide_terminal_and_restore` polling
                // loop (`translator.rs`): once the initial delay has passed,
                // keep re-checking every second for as long as the cursor
                // stays over the popup.
                self.interval = 1s;
                self.restart();
            } else {
                self.running = false;
                hide-requested();
            }
        }
    }

    // Called from Rust each time the popup is (re)shown. `running = true`
    // covers the never-started-yet case; `restart()` additionally resets the
    // countdown relative to *now* even if the timer was already running (a
    // second hotkey trigger while a previous popup is still visible must
    // restart the delay, not let the earlier schedule fire early and hide the
    // new popup out from under it).
    public function start-hide-timer() {
        hide-timer.interval = auto-hide-seconds * 1s;
        hide-timer.running = true;
        hide-timer.restart();
    }

    Rectangle {
        // popup-background (not the raw panel-background-theme-default) --
        // otherwise content-layout's own 8px padding exposes a visible
        // margin in the *raw* theme color around the inner phrase/
        // translation rectangles whenever popup-background resolves to
        // something else (an active named Color scheme, or an explicit
        // override), which reads as a border/frame no matter what
        // popup-border-width is set to.
        background: popup-background;
        border-width: popup-border-width * 1px;
        border-color: Palette.border;

        // touch-area wraps ScrollView (rather than sitting beside it as a
        // sibling) so `has-hover` keeps tracking correctly once the cursor is
        // over the scrollable content: a plain sibling TouchArea loses the
        // hit-testing race to ScrollView's own internal Flickable/ScrollBar
        // (each themselves TouchArea-based) once one is added, since sibling
        // TouchAreas at the same z-position compete exclusively for pointer
        // hits -- whichever is topmost (ScrollView, declared later) wins,
        // and the other's `has-hover` never becomes true again. Nesting
        // avoids that: hover bubbles up through ancestors independently of
        // which descendant handles the click/scroll/drag itself, so
        // touch-area still correctly reports hover while scrolling works
        // normally inside it. (Regression introduced when ScrollView was
        // added for the max-height/scrolling feature — before that, this
        // was the only interactive element here, so nothing competed for
        // hover in the first place.)
        touch-area := TouchArea {
            width: 100%;
            height: 100%;

            // Dragging no longer starts from here (2026-09-22) -- see phrase-copy's
            // own doc comment above for why it moved into the phrase/translation
            // blocks' own `TouchArea`s instead. This element only ever sees
            // pointer events over the popup's thin margin now (`content-layout`'s
            // padding plus the border), where there's no text to either copy or
            // drag-start from, so it keeps just the hover/engagement bookkeeping.
            moved => {
                root.start-hide-timer();
            }

            // Wheel-scrolling flips `has-hover` to false -- even with the
            // cursor never actually leaving the popup -- because
            // `ScrollView`'s internal `Flickable` grabs the mouse for the
            // duration of a wheel gesture, and that grab doesn't hand hover
            // tracking back to this TouchArea until the next real pointer
            // motion. Left alone, that reads as "user left" to `hide-timer`,
            // closing the popup out from under someone who just scrolled and
            // stopped to read -- exactly the reported bug. `ScrollView`'s own
            // `scrolled` callback (aliased to `Flickable.flicked`) can't be
            // used to work around it: it only fires when the viewport
            // position actually changes, which never happens when the
            // content already fits (precisely the case this bug shows up
            // in). `scroll-event` here instead fires on *any* wheel input
            // reaching this TouchArea, including one the child `Flickable`
            // ignored because there was nothing to scroll -- and a scroll
            // can only happen while the cursor is physically over this
            // window, so it's unambiguous proof of continued engagement.
            // `reject` passes it on so legitimate scrolling (content that
            // does overflow) still reaches the `Flickable` normally.
            scroll-event(event) => {
                root.start-hide-timer();
                reject
            }

            ScrollView {
                width: 100%;
                height: 100%;

                content-layout := VerticalLayout {
                    padding: 8px;
                    spacing: 4px;

                    if show-phrase: Rectangle {
                        background: popup-background;
                        border-radius: 3px;
                        height: phrase-line.preferred-height;
                        border-width: (copy-flash-active && copy-flash-is-phrase) ? 2px : 0px;
                        border-color: popup-prompt-accent;
                        animate border-width { duration: 220ms; easing: ease-out; }

                        phrase-line := StyledText {
                            text: phrase-styled;
                            default-color: popup-color;
                            default-font-family: popup-font;
                            default-font-size: popup-size * 1px;
                            x: 4px;
                            width: parent.width - 8px;
                        }

                        // Right-click copies this block; Ctrl+left-click drags the
                        // popup -- see phrase-copy's own doc comment above for why
                        // both live in this one nested TouchArea (mirroring the
                        // transcript's own per-block design for the copy half)
                        // rather than anything menu-based, and why dragging needs
                        // the Ctrl gate specifically. `drag-moved`/`drag-ended`
                        // fire unconditionally on every `moved`/up-or-cancel --
                        // harmless when no drag is in progress, since
                        // `wire_popup_drag` in main.rs (unchanged since dragging
                        // was first added) only acts on them when its own
                        // in-progress-drag state is `Some`.
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.down
                                    && event.button == PointerEventButton.left
                                    && event.modifiers.control {
                                    root.start-hide-timer();
                                    root.drag-started();
                                } else if event.kind == PointerEventKind.up
                                    && event.button == PointerEventButton.right
                                    && phrase-copy != "" {
                                    root.start-hide-timer();
                                    copy-flash-active = true;
                                    copy-flash-is-phrase = true;
                                    popup-copy-requested(true);
                                } else if event.kind == PointerEventKind.up
                                    || event.kind == PointerEventKind.cancel {
                                    root.drag-ended();
                                }
                            }
                            moved => {
                                root.start-hide-timer();
                                root.drag-moved();
                            }
                        }
                    }

                    Rectangle {
                        background: popup-background;
                        border-radius: 3px;
                        height: translation-line.preferred-height;
                        border-width: (copy-flash-active && !copy-flash-is-phrase) ? 2px : 0px;
                        border-color: popup-prompt-accent;
                        animate border-width { duration: 220ms; easing: ease-out; }

                        translation-line := StyledText {
                            text: translation-styled;
                            default-color: popup-color;
                            default-font-family: popup-font;
                            default-font-size: popup-size * 1px;
                            x: 4px;
                            width: parent.width - 8px;
                        }

                        // See the phrase block's own TouchArea above.
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.down
                                    && event.button == PointerEventButton.left
                                    && event.modifiers.control {
                                    root.start-hide-timer();
                                    root.drag-started();
                                } else if event.kind == PointerEventKind.up
                                    && event.button == PointerEventButton.right
                                    && translation-copy != "" {
                                    root.start-hide-timer();
                                    copy-flash-active = true;
                                    copy-flash-is-phrase = false;
                                    popup-copy-requested(false);
                                } else if event.kind == PointerEventKind.up
                                    || event.kind == PointerEventKind.cancel {
                                    root.drag-ended();
                                }
                            }
                            moved => {
                                root.start-hide-timer();
                                root.drag-moved();
                            }
                        }
                    }
                }
            }
        }
    }
}

// Stage 8 follow-up: press-the-actual-keys capture for the global hotkey
// field, as an addition next to the plain text field, not a replacement.
// `FocusScope`/`Timer`/the `Key` namespace are core-language builtins (like
// `Dialog`/`TabWidget`/`Tab`), not imported from std-widgets.
//
// State machine, entirely on the .slint side except the one text->token
// mapping step (`map-key-to-token`, implemented in main.rs since it needs
// the same key-name vocabulary `HotkeyParser`/`key_name_to_vk` already
// define -- no point duplicating that table here):
// - Escape cancels recording outright.
// - A lone modifier press (Ctrl/Alt/Shift/Win pressed by itself) is ignored;
//   we're still waiting for the real key.
// - A real key pressed together with a modifier finalizes immediately as a
//   modifier combo (e.g. "Ctrl+Shift+T") -- no double-press ambiguity when
//   modifiers are held.
// - A bare real key (no modifiers) starts (or restarts) a 500ms window --
//   the same max_interval_ms `HotkeyType::DoublePress` already validates
//   against -- during which a second bare press of the *same* key finalizes
//   as a double-press ("F8+F8"); a second bare press of a *different* key
//   restarts the window on the new key instead; and a timeout with nothing
//   else pressed finalizes the lone key by itself (which `validate_hotkey`
//   then accepts only for F1-F12, surfacing through the existing inline
//   error otherwise -- no special-casing needed here).
// - A key `map-key-to-token` doesn't recognize (most commonly: a non-Latin
//   keyboard layout producing a non-ASCII character for what should be a
//   plain letter key) reports through `unrecognized` instead of
//   `captured`, so main.rs can show a friendlier message than the generic
//   parser error.
component HotkeyRecorder inherits FocusScope {
    callback captured(string);
    callback unrecognized();
    callback cancelled();
    callback map-key-to-token(string) -> string;

    property <string> pending-key: "";

    double-press-timer := Timer {
        interval: 500ms;
        running: false;
        triggered => {
            self.running = false;
            if pending-key != "" {
                captured(pending-key);
                pending-key = "";
            }
        }
    }

    key-pressed(event) => {
        if event.repeat {
            return accept;
        }
        if event.text == Key.Escape {
            double-press-timer.running = false;
            pending-key = "";
            cancelled();
            return accept;
        }
        if event.text == Key.Alt || event.text == Key.AltGr || event.text == Key.Control
            || event.text == Key.ControlR || event.text == Key.Shift || event.text == Key.ShiftR
            || event.text == Key.Meta || event.text == Key.MetaR {
            return accept; // still waiting for the real key
        }

        let local-token = map-key-to-token(event.text);
        if local-token == "" {
            double-press-timer.running = false;
            pending-key = "";
            unrecognized();
            return accept;
        }

        if event.modifiers.control || event.modifiers.alt || event.modifiers.shift || event.modifiers.meta {
            double-press-timer.running = false;
            pending-key = "";
            captured(
                (event.modifiers.control ? "Ctrl+" : "")
                + (event.modifiers.alt ? "Alt+" : "")
                + (event.modifiers.shift ? "Shift+" : "")
                + (event.modifiers.meta ? "Win+" : "")
                + local-token
            );
            return accept;
        }

        if pending-key == local-token {
            double-press-timer.running = false;
            pending-key = "";
            captured(local-token + "+" + local-token);
            return accept;
        }

        pending-key = local-token;
        double-press-timer.running = true;
        double-press-timer.restart();
        return accept;
    }

    horizontal-stretch: 1;
    min-width: 160px;

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-width: 1px;
        border-color: Palette.border;
        border-radius: 4px;
        background: Palette.alternate-background;

        Text {
            text: "Press keys… (Esc cancels)";
            font-size: 11px;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
            width: parent.width - 8px;
        }
    }
}

export component SettingsDialog inherits Dialog {
    title: "Settings";
    preferred-width: 460px;
    preferred-height: 460px;

    // Same helper as AppWindow's — see its doc comment. This dialog has its
    // own separate Palette instance, so it needs its own call to this too.
    public function apply-theme(theme: string) {
        Palette.color-scheme = theme == "light" ? ColorScheme.light
            : theme == "dark" ? ColorScheme.dark
            : ColorScheme.unknown;
    }

    // Translation, dictionary and speech backends are three independent
    // choices (`tagent`'s three provider axes), each with its own list. All
    // three apply immediately (live-reloaded, no restart), like the
    // checkboxes below. The lists below are only placeholders: main.rs's
    // `seed_dialog_fields` replaces them with `tagent`'s own
    // `TRANSLATION_PROVIDERS`/`DICTIONARY_PROVIDERS`/`SPEECH_PROVIDERS`
    // whenever the dialog opens, so a new backend needs no edit here.
    in-out property <[string]> providers: ["google"];
    in-out property <int> provider-index: 0;
    in-out property <[string]> dictionary-providers: ["google"];
    in-out property <int> dictionary-provider-index: 0;
    in-out property <[string]> speech-providers: ["google"];
    in-out property <int> speech-provider-index: 0;
    // Stage 9: dictionary lookup for single-word input. Both apply immediately
    // (live-reloaded, no restart) -- see the General tab's own hint text below.
    in-out property <bool> show-dictionary: true;
    in-out property <bool> spell-check: true;
    // Stage 10: per-entry text-to-speech speaker buttons. Live-reloaded, same
    // as show-dictionary/spell-check above.
    in-out property <bool> enable-text-to-speech: true;
    // Right-click "Copy" menu vs. instant copy-on-right-click (see
    // AppWindow's own show-context-menu). Live-reloaded, same as the above.
    in-out property <bool> show-context-menu: false;
    in-out property <[string]> themes: ["Auto", "Light", "Dark"];
    in-out property <int> theme-index: 0;
    in-out property <string> app-version: "";

    // One-shot preset picker: selecting an entry (main.rs looks it up by
    // name) immediately fills in the background/phrase/translation color
    // fields below and switches Theme to match — it isn't itself a
    // persisted setting, just a bulk-fill shortcut for the individual color
    // pickers, which stay fully editable afterward. "Default" resets those
    // fields back to "" (theme default) and Theme to Auto, same shape as
    // every other named preset just with the theme-following colors.
    // "Custom" is the inert placeholder shown when the current colors don't
    // match any preset (including "Default") — selecting it is a no-op,
    // since it has no corresponding `ColorScheme` entry in main.rs.
    in-out property <[string]> color-scheme-options: [
        "Custom", "Default", "Solarized Dark", "Solarized Light", "Dracula", "Nord",
        "Gruvbox Dark", "Monokai", "One Dark", "Tokyo Night", "Catppuccin Mocha",
        "Night Owl", "Ayu Dark", "GitHub Light", "Gruvbox Light", "Catppuccin Latte"
    ];
    in-out property <int> color-scheme-index: 0;
    callback color-scheme-selected <=> color-scheme-combo.selected;

    // Vertical gaps (px) in the transcript — mirror AppWindow's
    // block-spacing-px/phrases-spacing-px.
    in-out property <int> block-spacing-px: 20;
    in-out property <int> phrases-spacing-px: 2;

    // Font choices shared by the phrase and translation style pickers below;
    // main.rs maps index 0/1/2 to the "monospace"/"sans-serif"/"serif"
    // font-family strings actually applied on AppWindow.
    in-out property <[string]> font-options: ["Monospace", "Sans Serif", "Serif"];
    in-out property <int> phrase-font-index: 0;
    in-out property <int> phrase-size: 13;
    in-out property <int> translation-font-index: 0;
    in-out property <int> translation-size: 13;

    in-out property <bool> background-use-default <=> background-color-field.use-default;
    in-out property <float> background-red <=> background-color-field.red;
    in-out property <float> background-green <=> background-color-field.green;
    in-out property <float> background-blue <=> background-color-field.blue;
    in-out property <string> background-hex <=> background-color-field.hex-text;
    callback background-hex-committed <=> background-color-field.hex-committed;
    callback background-rgb-changed <=> background-color-field.rgb-changed;

    in-out property <bool> phrase-color-use-default <=> phrase-text-color-field.use-default;
    in-out property <float> phrase-color-red <=> phrase-text-color-field.red;
    in-out property <float> phrase-color-green <=> phrase-text-color-field.green;
    in-out property <float> phrase-color-blue <=> phrase-text-color-field.blue;
    in-out property <string> phrase-color-hex <=> phrase-text-color-field.hex-text;
    callback phrase-color-hex-committed <=> phrase-text-color-field.hex-committed;
    callback phrase-color-rgb-changed <=> phrase-text-color-field.rgb-changed;

    in-out property <bool> phrase-bg-use-default <=> phrase-bg-color-field.use-default;
    in-out property <float> phrase-bg-red <=> phrase-bg-color-field.red;
    in-out property <float> phrase-bg-green <=> phrase-bg-color-field.green;
    in-out property <float> phrase-bg-blue <=> phrase-bg-color-field.blue;
    in-out property <string> phrase-bg-hex <=> phrase-bg-color-field.hex-text;
    callback phrase-bg-hex-committed <=> phrase-bg-color-field.hex-committed;
    callback phrase-bg-rgb-changed <=> phrase-bg-color-field.rgb-changed;

    in-out property <bool> prompt-color-use-default <=> prompt-text-color-field.use-default;
    in-out property <float> prompt-color-red <=> prompt-text-color-field.red;
    in-out property <float> prompt-color-green <=> prompt-text-color-field.green;
    in-out property <float> prompt-color-blue <=> prompt-text-color-field.blue;
    in-out property <string> prompt-color-hex <=> prompt-text-color-field.hex-text;
    callback prompt-color-hex-committed <=> prompt-text-color-field.hex-committed;
    callback prompt-color-rgb-changed <=> prompt-text-color-field.rgb-changed;

    in-out property <bool> translation-color-use-default <=> translation-text-color-field.use-default;
    in-out property <float> translation-color-red <=> translation-text-color-field.red;
    in-out property <float> translation-color-green <=> translation-text-color-field.green;
    in-out property <float> translation-color-blue <=> translation-text-color-field.blue;
    in-out property <string> translation-color-hex <=> translation-text-color-field.hex-text;
    callback translation-color-hex-committed <=> translation-text-color-field.hex-committed;
    callback translation-color-rgb-changed <=> translation-text-color-field.rgb-changed;

    in-out property <bool> translation-bg-use-default <=> translation-bg-color-field.use-default;
    in-out property <float> translation-bg-red <=> translation-bg-color-field.red;
    in-out property <float> translation-bg-green <=> translation-bg-color-field.green;
    in-out property <float> translation-bg-blue <=> translation-bg-color-field.blue;
    in-out property <string> translation-bg-hex <=> translation-bg-color-field.hex-text;
    callback translation-bg-hex-committed <=> translation-bg-color-field.hex-committed;
    callback translation-bg-rgb-changed <=> translation-bg-color-field.rgb-changed;

    in-out property <bool> show-prompt: true;

    // Style for the hotkey-triggered popup (Stage 6/9): one shared
    // Font/Size/Text color/Background, unlike the transcript's separate
    // phrase/translation style above.
    in-out property <int> popup-font-index: 0;
    in-out property <int> popup-size: 13;
    in-out property <bool> popup-show-prompt: true;
    in-out property <bool> show-popup: true;
    in-out property <bool> popup-show-phrase: true;
    in-out property <int> popup-max-width: 600;
    in-out property <int> popup-max-height: 600;
    in-out property <int> popup-border-width: 1;

    in-out property <bool> popup-color-use-default <=> popup-text-color-field.use-default;
    in-out property <float> popup-color-red <=> popup-text-color-field.red;
    in-out property <float> popup-color-green <=> popup-text-color-field.green;
    in-out property <float> popup-color-blue <=> popup-text-color-field.blue;
    in-out property <string> popup-color-hex <=> popup-text-color-field.hex-text;
    callback popup-color-hex-committed <=> popup-text-color-field.hex-committed;
    callback popup-color-rgb-changed <=> popup-text-color-field.rgb-changed;

    in-out property <bool> popup-prompt-color-use-default <=> popup-prompt-color-field.use-default;
    in-out property <float> popup-prompt-color-red <=> popup-prompt-color-field.red;
    in-out property <float> popup-prompt-color-green <=> popup-prompt-color-field.green;
    in-out property <float> popup-prompt-color-blue <=> popup-prompt-color-field.blue;
    in-out property <string> popup-prompt-color-hex <=> popup-prompt-color-field.hex-text;
    callback popup-prompt-color-hex-committed <=> popup-prompt-color-field.hex-committed;
    callback popup-prompt-color-rgb-changed <=> popup-prompt-color-field.rgb-changed;

    in-out property <bool> popup-bg-use-default <=> popup-bg-color-field.use-default;
    in-out property <float> popup-bg-red <=> popup-bg-color-field.red;
    in-out property <float> popup-bg-green <=> popup-bg-color-field.green;
    in-out property <float> popup-bg-blue <=> popup-bg-color-field.blue;
    in-out property <string> popup-bg-hex <=> popup-bg-color-field.hex-text;
    callback popup-bg-hex-committed <=> popup-bg-color-field.hex-committed;
    callback popup-bg-rgb-changed <=> popup-bg-color-field.rgb-changed;

    // Stage 8: the global hotkey string (Stage 5) and the popup auto-hide
    // delay (Stage 6), now editable here instead of only by hand in
    // tagent-gui.json. `translate-hotkey-error` is set from Rust (not
    // dialog-owned) after validating every edit via `translate-hotkey-edited`
    // -- non-empty disables the OK button below.
    in-out property <string> translate-hotkey: "Alt+A";
    in property <string> translate-hotkey-error: "";
    callback translate-hotkey-edited(string);
    in-out property <int> popup-auto-hide-seconds: 3;
    in-out property <bool> remember-popup-position: false;

    // Stage 10 follow-up: a second, independent global hotkey that speaks the
    // current selection directly (no translation). Same field/error/edited
    // shape as translate-hotkey above -- see speech-hotkey-error's own
    // enabled-OK-button check below.
    in-out property <string> speech-hotkey: "Alt+S";
    in property <string> speech-hotkey-error: "";
    callback speech-hotkey-edited(string);
    in-out property <bool> enable-speech-hotkey: true;

    // Stage 8 follow-up: "Record" button -- press-the-actual-keys capture,
    // as an addition next to the plain text field above, not a replacement.
    // `is-recording-translate`/`is-recording-speech` are session-only UI
    // state, never persisted -- split into two (Stage 10 follow-up, renamed
    // from a single `is-recording`) since each hotkey field gets its own
    // independent Record button/HotkeyRecorder instance.
    in-out property <bool> is-recording-translate: false;
    in-out property <bool> is-recording-speech: false;
    callback translate-hotkey-unrecognized();
    callback speech-hotkey-unrecognized();
    // Shared by both HotkeyRecorder instances -- a stateless key-name lookup
    // with no per-field behavior, so one Rust handler suffices for both.
    callback map-key-to-token(string) -> string;
    // Fired whenever *either* field's recording state changes, with "is either
    // one currently recording" (not which one) -- lets main.rs suppress both
    // global hotkeys while any recording is in progress. See
    // `recording_started_at`'s doc comment in `main()` for why.
    callback recording-changed(bool);

    // Stage 7: whether the app launches straight into the tray with no window
    // shown. Default is `true`, and shipping that default with no in-app way
    // to turn it back off would be a dead end, hence a real control here.
    in-out property <bool> start-minimized: true;

    // Stage 7 follow-up: whether the main window's size/position are saved on
    // hide-to-tray/quit and restored the next time it's shown. The saved
    // x/y/width/height themselves aren't dialog-editable fields -- they're
    // captured automatically from the real window -- so only this on/off
    // toggle lives here, same "field before its own editor" split as
    // popup-delay/translate-hotkey above.
    in-out property <bool> remember-window-geometry: true;

    callback save-requested(string /* provider */, string /* theme */);
    // Closes the dialog without saving -- edits made in this session are
    // discarded (the dialog instance itself is dropped on close, and is never
    // read from again; the config file is untouched since `update()` is only
    // ever called from `save-requested`'s handler).
    callback cancel-requested();
    // Fills every field on every tab with `GuiConfig::default()`'s values,
    // in-memory only -- same as opening the dialog, but seeded from defaults
    // instead of the saved config. Still requires OK to actually persist;
    // Cancel discards it like any other in-session edit.
    callback reset-to-defaults-requested();

    // Tabbed layout: "General" holds the provider, "View" holds the theme
    // plus the phrase/translation display style, "Hotkeys & Tray" holds the
    // global hotkey, popup auto-hide delay, start-minimized and
    // remember-window-geometry toggles. Adding a category later means adding
    // another `Tab { ... }` here, not restructuring the dialog.
    TabWidget {
        Tab {
            title: "General";

            VerticalBox {
                alignment: start;

                // Label/dropdown pairs share a row, so the General tab doesn't
                // grow by two lines per provider axis.
                GridLayout {
                    spacing: 8px;
                    Row {
                        Text { text: "Translate provider:"; vertical-alignment: center; }
                        ComboBox {
                            model: providers;
                            current-index <=> provider-index;
                        }
                    }
                    Row {
                        Text { text: "Dictionary provider:"; vertical-alignment: center; }
                        ComboBox {
                            model: dictionary-providers;
                            current-index <=> dictionary-provider-index;
                        }
                    }
                    Row {
                        Text { text: "Speech provider:"; vertical-alignment: center; }
                        ComboBox {
                            model: speech-providers;
                            current-index <=> speech-provider-index;
                        }
                    }
                }

                CheckBox { text: "Show dictionary for single words"; checked <=> show-dictionary; }
                CheckBox { text: "Spell check suggestions"; checked <=> spell-check; }
                CheckBox { text: "Enable text-to-speech"; checked <=> enable-text-to-speech; }
                Text {
                    text: "Applies to the next translation immediately — no restart needed. \"Spell check suggestions\" has no effect while \"Show dictionary\" is off.";
                    wrap: word-wrap;
                }

                CheckBox { text: "Show menu on right-click"; checked <=> show-context-menu; }
                Text {
                    text: "When off (default), right-click a transcript block copies it immediately -- a brief border flash confirms it. When on, right-click opens a \"Copy\" menu instead. Applies immediately, no restart needed.";
                    wrap: word-wrap;
                }

                Button {
                    text: "Reset to Defaults";
                    clicked => { reset-to-defaults-requested(); }
                }
                Text {
                    text: "Resets every setting on every tab to its default value. Nothing is saved until you click OK.";
                    wrap: word-wrap;
                }
            }
        }

        Tab {
            title: "View";

            ScrollView {
                VerticalBox {
                    alignment: start;

                    Text { text: "Theme:"; }
                    ComboBox {
                        model: themes;
                        current-index <=> theme-index;
                    }

                    Text { text: "Color scheme:"; }
                    color-scheme-combo := ComboBox {
                        model: color-scheme-options;
                        current-index <=> color-scheme-index;
                    }

                    background-color-field := ColorPickerField { label: "Background color:"; }

                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Blocks spacing (px):"; vertical-alignment: center; }
                        SpinBox { minimum: 0; maximum: 200; value <=> block-spacing-px; }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Phrases spacing (px):"; vertical-alignment: center; }
                        SpinBox { minimum: 0; maximum: 100; value <=> phrases-spacing-px; }
                    }
                    CheckBox { text: "Show prompt"; checked <=> show-prompt; }
                    prompt-text-color-field := ColorPickerField { label: "Prompt color:"; }

                    Text { text: "Phrase"; font-weight: 700; }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Font:"; vertical-alignment: center; }
                        ComboBox { model: font-options; current-index <=> phrase-font-index; }
                        Text { text: "Size:"; vertical-alignment: center; }
                        SpinBox { minimum: 8; maximum: 48; value <=> phrase-size; }
                    }
                    phrase-text-color-field := ColorPickerField { label: "Text color:"; }
                    phrase-bg-color-field := ColorPickerField { label: "Background:"; }

                    Text { text: "Translation"; font-weight: 700; }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Font:"; vertical-alignment: center; }
                        ComboBox { model: font-options; current-index <=> translation-font-index; }
                        Text { text: "Size:"; vertical-alignment: center; }
                        SpinBox { minimum: 8; maximum: 48; value <=> translation-size; }
                    }
                    translation-text-color-field := ColorPickerField { label: "Text color:"; }
                    translation-bg-color-field := ColorPickerField { label: "Background:"; }
                }
            }
        }

        Tab {
            title: "Hotkeys & Tray";

            VerticalBox {
                alignment: start;

                Text { text: "Global hotkey (translate):"; }
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit {
                        visible: !is-recording-translate;
                        text <=> translate-hotkey;
                        edited(text) => { translate-hotkey-edited(text); }
                    }
                    translate-recorder := HotkeyRecorder {
                        visible: is-recording-translate;
                        height: 32px;
                        map-key-to-token(text) => { root.map-key-to-token(text) }
                        captured(hotkey) => {
                            is-recording-translate = false;
                            root.recording-changed(is-recording-speech);
                            translate-hotkey = hotkey;
                            translate-hotkey-edited(hotkey);
                        }
                        unrecognized => {
                            is-recording-translate = false;
                            root.recording-changed(is-recording-speech);
                            root.translate-hotkey-unrecognized();
                        }
                        cancelled => {
                            is-recording-translate = false;
                            root.recording-changed(is-recording-speech);
                        }
                    }
                    Button {
                        text: is-recording-translate ? "Cancel" : "Record";
                        clicked => {
                            is-recording-translate = !is-recording-translate;
                            root.recording-changed(is-recording-translate || is-recording-speech);
                            if is-recording-translate {
                                translate-recorder.focus();
                            }
                        }
                    }
                }
                Text {
                    text: translate-hotkey-error;
                    color: #e05252;
                    wrap: word-wrap;
                    visible: translate-hotkey-error != "";
                }

                Text { text: "Global hotkey (speech):"; }
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit {
                        visible: !is-recording-speech;
                        text <=> speech-hotkey;
                        edited(text) => { speech-hotkey-edited(text); }
                    }
                    speech-recorder := HotkeyRecorder {
                        visible: is-recording-speech;
                        height: 32px;
                        map-key-to-token(text) => { root.map-key-to-token(text) }
                        captured(hotkey) => {
                            is-recording-speech = false;
                            root.recording-changed(is-recording-translate);
                            speech-hotkey = hotkey;
                            speech-hotkey-edited(hotkey);
                        }
                        unrecognized => {
                            is-recording-speech = false;
                            root.recording-changed(is-recording-translate);
                            root.speech-hotkey-unrecognized();
                        }
                        cancelled => {
                            is-recording-speech = false;
                            root.recording-changed(is-recording-translate);
                        }
                    }
                    Button {
                        text: is-recording-speech ? "Cancel" : "Record";
                        clicked => {
                            is-recording-speech = !is-recording-speech;
                            root.recording-changed(is-recording-translate || is-recording-speech);
                            if is-recording-speech {
                                speech-recorder.focus();
                            }
                        }
                    }
                }
                Text {
                    text: speech-hotkey-error;
                    color: #e05252;
                    wrap: word-wrap;
                    visible: speech-hotkey-error != "";
                }
                CheckBox { text: "Enable speech hotkey"; checked <=> enable-speech-hotkey; }

                CheckBox { text: "Start minimized to tray"; checked <=> start-minimized; }
                CheckBox {
                    text: "Remember window size and position";
                    checked <=> remember-window-geometry;
                }

                Text {
                    text: "The global hotkeys take effect only after restarting Tagent. \"Start minimized\"/\"Remember window size and position\" apply the next time the window is shown or the app restarts. Pressing Esc while the speech hotkey (or a transcript speaker button) is playing stops it, even if Tagent isn't the focused window.";
                    wrap: word-wrap;
                }
            }
        }

        Tab {
            title: "Popup";

            ScrollView {
                VerticalBox {
                    alignment: start;

                    Text {
                        text: "Style for the small popup shown next to the cursor after the global hotkey translates your selection. Drag it with the mouse to move it; with \"Remember position after dragging\" on, it reappears where you left it instead of next to the cursor. Turn off \"Show popup on hotkey\" to have the hotkey translate into the transcript only.";
                        wrap: word-wrap;
                    }

                    CheckBox { text: "Show popup on hotkey"; checked <=> show-popup; }
                    CheckBox { text: "Show prompt"; checked <=> popup-show-prompt; }
                    popup-prompt-color-field := ColorPickerField { label: "Prompt color:"; }
                    CheckBox { text: "Show phrase"; checked <=> popup-show-phrase; }
                    CheckBox {
                        text: "Remember position after dragging";
                        checked <=> remember-popup-position;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Font:"; vertical-alignment: center; }
                        ComboBox { model: font-options; current-index <=> popup-font-index; }
                        Text { text: "Size:"; vertical-alignment: center; }
                        SpinBox { minimum: 8; maximum: 48; value <=> popup-size; }
                    }
                    popup-text-color-field := ColorPickerField { label: "Text color:"; }
                    popup-bg-color-field := ColorPickerField { label: "Background:"; }

                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Auto-hide (seconds):"; vertical-alignment: center; }
                        SpinBox { minimum: 0; maximum: 60; value <=> popup-auto-hide-seconds; }
                        Text { text: "(0 = default 3s)"; vertical-alignment: center; }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Max width (px):"; vertical-alignment: center; }
                        SpinBox { minimum: 150; maximum: 1000; value <=> popup-max-width; }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Max height (px):"; vertical-alignment: center; }
                        SpinBox { minimum: 80; maximum: 1000; value <=> popup-max-height; }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Border width (px):"; vertical-alignment: center; }
                        SpinBox { minimum: 0; maximum: 20; value <=> popup-border-width; }
                    }

                    Text {
                        text: "Text taller than the max height scrolls instead of growing the popup further. \"Theme default\" follows the transcript's own Color scheme (View tab), not just the raw Auto/Light/Dark theme. Everything on this tab applies immediately.";
                        wrap: word-wrap;
                    }
                }
            }
        }

        Tab {
            title: "About";

            VerticalBox {
                alignment: start;

                Text { text: "Tagent"; font-weight: 700; }
                Text { text: "Version " + app-version; }
            }
        }
    }

    StandardButton {
        kind: ok;
        enabled: translate-hotkey-error == "" && speech-hotkey-error == "";
        clicked => { save-requested(providers[provider-index], themes[theme-index]); }
    }
    // `kind` alone only affects the button's label/position -- unlike OK's
    // `save-requested`, nothing closes the dialog without an explicit handler.
    StandardButton { kind: cancel; clicked => { cancel-requested(); } }
}

// Stage 7: system tray icon. One instance is created in main.rs and kept alive
// for the whole process lifetime -- per SystemTrayIcon's own docs, the icon
// appears as soon as the instance exists and an event loop is running, and
// disappears when the instance is dropped, so no `.show()`/`.hide()` call is
// needed (or wanted -- see below). Left-click and the "Show Tagent" menu item
// both just ask main.rs to reveal the main window; "Settings…" reuses the
// existing Settings dialog; "Quit" is now the only way to actually exit the
// app, since AppWindow's own close button (main.rs) is redirected to hide
// instead of quit.
export component TrayIcon inherits SystemTrayIcon {
    icon: @image-url("../assets/icons/tray.png");
    tooltip: "Tagent";

    callback show-requested();
    callback settings-requested();
    callback quit-requested();

    clicked => { show-requested(); }

    Menu {
        MenuItem { title: "Show Tagent"; activated => { show-requested(); } }
        MenuItem { title: "Settings…"; activated => { settings-requested(); } }
        MenuSeparator {}
        MenuItem { title: "Quit"; activated => { quit-requested(); } }
    }
}
