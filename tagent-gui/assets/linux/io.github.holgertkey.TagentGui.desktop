[Desktop Entry]
Type=Application
Name=Tagent
GenericName=Translator
Comment=Tagent GUI — cross-platform desktop text translator built with Slint: global hotkey, tray icon, dictionary and text-to-speech
Exec=tagent-gui
Icon=io.github.holgertkey.TagentGui
Terminal=false
Categories=Utility;
Keywords=translate;translation;dictionary;
StartupWMClass=io.github.holgertkey.TagentGui
